rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // قرار المالك ٢٠٢٦-١٠-٢٩: الكتابة للعام فقط؛ إعادة فتح review-day أو summer بتعديل هذا الشرط في المستودع ثم الرفع بالـCLI.
    function canWrite(programId) {
      return isAdmin() && programId == 'general';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // البرامج والمواسم والطلاب
    match /programs/{programId} {
      allow read: if isAdmin();
      allow write: if canWrite(programId);

      match /seasons/{seasonId} {
        allow read: if isAdmin();
        allow write: if canWrite(programId);

        match /students/{studentId} {
          allow read: if isAdmin();
          allow write: if canWrite(programId);
        }
      }
    }

    // مجموعات قديمة - مغلقة نهائياً
    match /events/{eventId} {
      allow read, write: if false;
      match /students/{studentId} { allow read, write: if false; }
    }
    match /students/{studentId} { allow read, write: if false; }
    match /test_students/{doc} { allow read, write: if false; }
  }
}
